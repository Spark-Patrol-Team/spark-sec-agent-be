# ==============================================================================
# spark-sec-agent-be 环境变量模板
# ==============================================================================
# 使用方式：
#   1. cp .env.example .env
#   2. 按本地环境修改 .env
#   3. 启动服务：uvicorn sec_agent.main:app --reload
#
# 说明：
#   - .env.example 可以提交到仓库。
#   - .env 是个人本地配置，禁止提交。
#   - 当前代码会自动读取项目根目录下的 .env。
#   - 真实密码、Token、连接码不要写入 .env.example。
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. 应用基础配置
# ------------------------------------------------------------------------------

# 应用名称，仅用于服务标识和健康检查。
APP_NAME=spark-sec-agent-be

# 运行环境：local / dev / test / prod。
APP_ENV=local

# 日志等级：DEBUG / INFO / WARNING / ERROR。
LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# 2. HTTP 服务配置
# ------------------------------------------------------------------------------
# 当前本地启动仍以 uvicorn 命令参数为准：
#   uvicorn sec_agent.main:app --host 127.0.0.1 --port 8000 --reload
# 以下变量先作为团队统一约定，后续如果封装启动脚本可以直接复用。

API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true


# ------------------------------------------------------------------------------
# 3. 存储组件
# ------------------------------------------------------------------------------
# 可选值：
#   memory：默认，本地演示和单元测试使用，不依赖外部数据库。
#   mysql：使用 MySQL 持久化 EventContext 和幂等键。

STORAGE_BACKEND=memory


# ------------------------------------------------------------------------------
# 4. MySQL 组件
# ------------------------------------------------------------------------------
# 数据库选型已确定为 MySQL。
# 本地可通过 docker-compose.yml 启动：
#   docker compose up -d mysql
#
# 推荐优先使用拆分配置，便于不同环境替换。

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sec_agent
MYSQL_PASSWORD=sec_agent
MYSQL_DATABASE=sec_agent
MYSQL_CHARSET=utf8mb4

# 启动时是否自动创建当前 MVP 最小表结构。
# 本地开发可以 true；生产或正式测试环境建议改为 false，并使用迁移脚本管理表结构。
MYSQL_AUTO_CREATE_SCHEMA=true

# 可选：完整 DSN。设置后会优先使用 MYSQL_DSN，忽略上面的拆分配置。
# MYSQL_DSN=mysql+pymysql://sec_agent:sec_agent@127.0.0.1:3306/sec_agent?charset=utf8mb4


# ------------------------------------------------------------------------------
# 5. 平台接入组件
# ------------------------------------------------------------------------------
# 当前可选值：
#   fixed_sample：固定样例适配器，用于在无真实平台时演示主流程。
#   jsonl_sample：读取 tests/fixtures/fixed_alerts 下的 JSONL 标准化告警样例。
#   xdr_openapi：XDR OpenAPI 真实平台接入边界，启用后需要补齐下面的 XDR 配置。
#
# 后续预留值：
#   mcp：MCP 工具接入，等待工具清单补齐。
#   fastgpt：FastGPT/OpenClaw 接入，等待调用方式补齐。

PLATFORM_BACKEND=fixed_sample

# JSONL 样例目录。相对路径按项目根目录解析。
JSONL_SAMPLE_DIR=tests/fixtures/fixed_alerts

# JSONL 输入模式：
#   normalized：直接读取 normalized_alerts.jsonl。
#   raw：读取 raw_alerts.jsonl，并在平台接入层完成标准化后进入同一主链。
JSONL_INPUT_MODE=normalized


# ------------------------------------------------------------------------------
# 6. XDR OpenAPI 组件
# ------------------------------------------------------------------------------
# 以下变量名可以进入仓库模板，但真实值禁止进入 GitHub/GitLab/Gitee：
#   XDR_BASE_URL / XDR_TOKEN / XDR_ACCESS_KEY / XDR_SECRET_KEY
# 正式联调环境建议由本机 .env、CI secret 或密钥管理系统注入。

# XDR_BASE_URL=
# 鉴权类型：
#   token：发送 Authorization: Bearer <XDR_TOKEN>
#   aksk：按 HMAC-SHA256 示例生成 X-XDR-Access-Key / Timestamp / Nonce / Signature
# XDR_AUTH_TYPE=token
# XDR_TOKEN=
# XDR_ACCESS_KEY=
# XDR_SECRET_KEY=
# XDR_ALERTS_PATH=/api/v1/alerts
# XDR_LOGS_PATH=/api/v1/logs
# XDR_CONNECT_TIMEOUT_SECONDS=5
# XDR_READ_TIMEOUT_SECONDS=30

# 启动前配置检查：true 时会校验必填项和超时边界；默认不做网络探测。
# 如需启动时真实探测平台连通性，再开启 XDR_PREFLIGHT_HTTP_CHECK。
# XDR_STARTUP_CHECK=true
# XDR_PREFLIGHT_HTTP_CHECK=false

# 真实平台失败时是否允许回退固定样例。
# 仅建议在联调演示或平台短时不可达时开启；鉴权失败和字段映射失败不会降级。
# XDR_ALLOW_FIXED_SAMPLE_FALLBACK=false


# ------------------------------------------------------------------------------
# 7. 深度调查 Agent（deep_agent）组件
# ------------------------------------------------------------------------------
# 深度调查子智能体通过 LLM 工具调用循环消费真实 XDR MCP 工具。
# 变量解析优先级：环境变量 > 本地文件（llm_config.local.json / mcp_servers.local.json）> 默认值。

# LLM（OpenAI 兼容接口）。真实 key 不进入仓库，可由 llm_config.local.json 或本机 .env 注入。
LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT=90

# 工具模式：mock（仅 Mock）/ mcp（仅真实 MCP，连不上直接失败）/ auto（Mock 兜底 + 真实 MCP 并存，默认）。
TOOL_MODE=auto
# 主链通过 DeepAgentBridge 调用子智能体时，用 DEEP_AGENT_TOOL_MODE 覆盖 TOOL_MODE（可选）。
# DEEP_AGENT_TOOL_MODE=mcp

# 深信服 MCP 服务地址：JSON 字典 {名称: url}。真实地址按敏感凭据处理，不入库。
# 也可不设 MCP_URLS，改用与 config.py 同目录的 mcp_servers.local.json（已 gitignore）。
# MCP_URLS={"网络安全数据查询":"https://..."}
# MCP_API_KEY=
# 深信服 MCP 走 HTTPS 自签证书/IP 直连，默认关闭证书校验；设 1 开启。
# MCP_VERIFY_SSL=0

# Agent 调查行为上限。
# AGENT_MAX_STEPS=5
# AGENT_MAX_TOOL_CALLS=12


# ------------------------------------------------------------------------------
# 8. FastGPT / OpenClaw 组件，占位配置，当前代码暂未启用
# ------------------------------------------------------------------------------

# FASTGPT_BASE_URL=
# FASTGPT_APP_ID=
# FASTGPT_API_KEY=
# FASTGPT_TIMEOUT_SECONDS=60


# ------------------------------------------------------------------------------
# 9. 安全与审计组件，占位配置，当前代码部分由模型字段承载
# ------------------------------------------------------------------------------

# 是否允许真实高风险处置动作。MVP 阶段建议保持 false。
ALLOW_REAL_HIGH_RISK_ACTION=false

# 是否强制高风险动作人工审批。MVP 阶段必须保持 true。
REQUIRE_APPROVAL_FOR_HIGH_RISK=true

# 审计日志输出位置，当前预留。
# AUDIT_LOG_PATH=logs/audit.log
