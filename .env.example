# ==============================================================================
# spark-sec-agent-be 环境变量模板
# ==============================================================================
# 使用方式：
#   1. cp .env.example .env
#   2. 按本地环境修改 .env
#   3. 启动服务：uvicorn sec_agent.main:app --reload
#
# 说明：
#   - .env.example 可以提交到仓库。
#   - .env 是个人本地配置，禁止提交。
#   - 当前代码会自动读取项目根目录下的 .env。
#   - 真实密码、Token、连接码不要写入 .env.example。
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. 应用基础配置
# ------------------------------------------------------------------------------

# 应用名称，仅用于服务标识和健康检查。
APP_NAME=spark-sec-agent-be

# 运行环境：local / dev / test / prod。
APP_ENV=local

# 日志等级：DEBUG / INFO / WARNING / ERROR。
LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# 2. HTTP 服务配置
# ------------------------------------------------------------------------------
# 当前本地启动仍以 uvicorn 命令参数为准：
#   uvicorn sec_agent.main:app --host 127.0.0.1 --port 8000 --reload
# 以下变量先作为团队统一约定，后续如果封装启动脚本可以直接复用。

API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true


# ------------------------------------------------------------------------------
# 3. 存储组件
# ------------------------------------------------------------------------------
# 可选值：
#   memory：默认，本地演示和单元测试使用，不依赖外部数据库。
#   mysql：使用 MySQL 持久化 EventContext 和幂等键。

STORAGE_BACKEND=memory


# ------------------------------------------------------------------------------
# 4. MySQL 组件
# ------------------------------------------------------------------------------
# 数据库选型已确定为 MySQL。
# 本地可通过 docker-compose.yml 启动：
#   docker compose up -d mysql
#
# 推荐优先使用拆分配置，便于不同环境替换。

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sec_agent
MYSQL_PASSWORD=sec_agent
MYSQL_DATABASE=sec_agent
MYSQL_CHARSET=utf8mb4

# 启动时是否自动创建当前 MVP 最小表结构。
# 本地开发可以 true；生产或正式测试环境建议改为 false，并使用迁移脚本管理表结构。
MYSQL_AUTO_CREATE_SCHEMA=true

# 可选：完整 DSN。设置后会优先使用 MYSQL_DSN，忽略上面的拆分配置。
# MYSQL_DSN=mysql+pymysql://sec_agent:sec_agent@127.0.0.1:3306/sec_agent?charset=utf8mb4


# ------------------------------------------------------------------------------
# 5. 平台接入组件
# ------------------------------------------------------------------------------
# 当前可选值：
#   fixed_sample：固定样例适配器，用于在无真实平台时演示主流程。
#   jsonl_sample：读取 tests/fixtures/fixed_alerts 下的 JSONL 标准化告警样例。
#   xdr_openapi：XDR OpenAPI 真实平台接入边界，启用后需要补齐下面的 XDR 配置。
#
# 后续预留值：
#   mcp：MCP 工具接入，等待工具清单补齐。
#   fastgpt：FastGPT/OpenClaw 接入，等待调用方式补齐。

PLATFORM_BACKEND=fixed_sample

# JSONL 样例目录。相对路径按项目根目录解析。
JSONL_SAMPLE_DIR=tests/fixtures/fixed_alerts

# JSONL 输入模式：
#   normalized：直接读取 normalized_alerts.jsonl。
#   raw：读取 raw_alerts.jsonl，并在平台接入层完成标准化后进入同一主链。
JSONL_INPUT_MODE=normalized


# ------------------------------------------------------------------------------
# 6. XDR OpenAPI 组件（真实接口 + 官方签名）
# ------------------------------------------------------------------------------
# 契约依据：《XDR_OpenAPI更新版》《真实XDR_OpenAPI_脱敏接口契约交接文档》
# 实际只读接口：POST /api/xdr/v1/alerts/list
# 官方签名算法：aksk_py3.py::Signature（等价 OfficialXdrSigner）
# 以下变量名可进入仓库模板；真实值禁止进入 GitHub/GitLab/Gitee，建议本机 .env/CI secret/密钥系统注入。

# XDR_BASE_URL=https://<xdr-host>:<port>

# 鉴权类型（默认 aksk，与官方 SDK 默认值一致）：
#   token：Authorization: Bearer <XDR_TOKEN>
#   aksk ：HMAC-SHA256 官方签名（XDR_ACCESS_KEY + XDR_SECRET_KEY）← 《07方案》推荐
#   auth_code：联动码模式（XDR_AUTH_CODE），SDK 内部用 AES-CBC 解码得到 AK/SK
XDR_AUTH_TYPE=aksk

# token 模式
# XDR_TOKEN=

# aksk 模式（与 aksk_py3.py 对齐；推荐）
# XDR_ACCESS_KEY=
# XDR_SECRET_KEY=

# auth_code 模式（联动码；与 AK/SK 二选一）
# XDR_AUTH_CODE=

# 接口路径（脱敏契约中的真实只读路径）
XDR_ALERTS_PATH=/api/xdr/v1/alerts/list
XDR_LOGS_PATH=/api/xdr/v1/logs/list

# 分页 & 时间范围：
#   pageSize 默认 50；max_pages 是安全上限防止无限翻页；
#   startTimestamp 对应《历史非空查询参数》1787155200（2026-08-19 00:00:00 UTC）
XDR_PAGE_SIZE=50
XDR_MAX_PAGES=50
XDR_START_TIMESTAMP=1787155200

# TLS 校验：真实 XDR 常为自签证书，默认 false（与 test_aksk.py 的 session.verify=False 一致）
XDR_VERIFY_TLS=false

# HTTP 超时
XDR_CONNECT_TIMEOUT_SECONDS=5
XDR_READ_TIMEOUT_SECONDS=30

# 启动前检查：
#   XDR_STARTUP_CHECK：true 时校验配置边界（base_url / auth_secret / 路径 等）
#   XDR_PREFLIGHT_HTTP_CHECK：true 时额外发一次最小只读 body 的 POST，探测连通性（默认 true）
XDR_STARTUP_CHECK=true
XDR_PREFLIGHT_HTTP_CHECK=true

# 真实平台失败时是否允许回退 fixed_sample。
# 仅联调演示或平台短时不可达时开启；**鉴权失败、定向筛选NOT_FOUND、字段映射失败不降级**。
XDR_ALLOW_FIXED_SAMPLE_FALLBACK=false


# ------------------------------------------------------------------------------
# 7. MCP 工具组件，占位配置，当前代码暂未启用
# ------------------------------------------------------------------------------

# MCP_SERVER_URL=
# MCP_AUTH_TOKEN=
# MCP_CONNECT_TIMEOUT_SECONDS=5
# MCP_READ_TIMEOUT_SECONDS=30


# ------------------------------------------------------------------------------
# 8. FastGPT / OpenClaw 组件，占位配置，当前代码暂未启用
# ------------------------------------------------------------------------------

# FASTGPT_BASE_URL=
# FASTGPT_APP_ID=
# FASTGPT_API_KEY=
# FASTGPT_TIMEOUT_SECONDS=60


# ------------------------------------------------------------------------------
# 9. 安全与审计组件，占位配置，当前代码部分由模型字段承载
# ------------------------------------------------------------------------------

# 是否允许真实高风险处置动作。MVP 阶段建议保持 false。
ALLOW_REAL_HIGH_RISK_ACTION=false

# 是否强制高风险动作人工审批。MVP 阶段必须保持 true。
REQUIRE_APPROVAL_FOR_HIGH_RISK=true

# 审计日志输出位置，当前预留。
# AUDIT_LOG_PATH=logs/audit.log
